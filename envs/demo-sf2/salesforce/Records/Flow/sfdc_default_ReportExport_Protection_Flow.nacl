            },
            {
              leftValueReference = "myVariable_myEvent.RowsProcessed"
              operator = "GreaterThan"
              rightValue = {
                numberValue = 10000
              }
            },
          ]
          connector = {
            targetReference = "EvaluationOutcomeAssignment"
          }
          label = "MatchAll"
        },
      ]
