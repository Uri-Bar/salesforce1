type salesforce.ShippingCarrierMethod {
  salesforce.Text ExternalReference {
    apiName = "ShippingCarrierMethod.ExternalReference"
    length = 255
    _required = true
    label = "External Reference"
    unique = false
    caseSensitive = false
  }
  salesforce.Unknown FridayPickUpTime {
    apiName = "ShippingCarrierMethod.FridayPickUpTime"
  }
  salesforce.Picklist ManagedShippingCarrierMethod {
    apiName = "ShippingCarrierMethod.ManagedShippingCarrierMethod"
    inlineHelpText = "Salesforce managed shipping carrier method information that provides estimated transit times."
    label = "Managed Shipping Carrier Method"
    restricted = true
  }
  salesforce.Number MaxTransitTime {
    apiName = "ShippingCarrierMethod.MaxTransitTime"
    _required = true
    label = "Maximum Transit Time"
    precision = 9
    scale = 0
    unique = false
  }
  salesforce.Number MinTransitTime {
    apiName = "ShippingCarrierMethod.MinTransitTime"
    label = "Minimum Transit Time"
    precision = 9
    scale = 0
    unique = false
  }
  salesforce.Unknown MondayPickUpTime {
    apiName = "ShippingCarrierMethod.MondayPickUpTime"
  }
  salesforce.Text Name {
    apiName = "ShippingCarrierMethod.Name"
    length = 255
    _required = true
    label = "Name"
    unique = false
    caseSensitive = false
  }
  salesforce.Unknown ProcessingTime {
    apiName = "ShippingCarrierMethod.ProcessingTime"
  }
  salesforce.Unknown ProcessingTimeUnit {
    apiName = "ShippingCarrierMethod.ProcessingTimeUnit"
  }
  salesforce.Unknown SaturdayPickUpTime {
    apiName = "ShippingCarrierMethod.SaturdayPickUpTime"
  }
  salesforce.Unknown ShippingAreaType {
    apiName = "ShippingCarrierMethod.ShippingAreaType"
  }
  salesforce.Lookup ShippingCarrierId {
    apiName = "ShippingCarrierMethod.ShippingCarrierId"
    relationshipName = "ShippingCarrier"
    label = "Shipping Carrier ID"
  }
  salesforce.Picklist ShippingScope {
    apiName = "ShippingCarrierMethod.ShippingScope"
    inlineHelpText = "Type of shipping available for the shipping carrier method."
    label = "Shipping Scope"
    restricted = true
  }
  salesforce.Unknown SundayPickUpTime {
    apiName = "ShippingCarrierMethod.SundayPickUpTime"
  }
  salesforce.Unknown ThursdayPickUpTime {
    apiName = "ShippingCarrierMethod.ThursdayPickUpTime"
  }
  salesforce.Picklist TransitTimeUnit {
    apiName = "ShippingCarrierMethod.TransitTimeUnit"
    restricted = true
    _required = true
    label = "Transit Time Unit"
  }
  salesforce.Unknown TuesdayPickUpTime {
    apiName = "ShippingCarrierMethod.TuesdayPickUpTime"
  }
  salesforce.Unknown WednesdayPickUpTime {
    apiName = "ShippingCarrierMethod.WednesdayPickUpTime"
  }
  serviceid Id {
    apiName = "ShippingCarrierMethod.Id"
    label = "Shipping Carrier Method ID"
